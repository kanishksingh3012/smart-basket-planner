    "@internationalized/date": "^3.12.4",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ai": "^7.0.120",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
